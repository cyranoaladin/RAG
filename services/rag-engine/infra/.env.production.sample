# Production environment template for rag-local (edit before use)
# Copy this file to infra/.env and replace placeholder values.

# --- Domains & time zone ---
RAG_UI_EXTERNAL_DOMAIN=rag-ui.example.com
RAG_API_EXTERNAL_DOMAIN=rag-api.example.com
TZ=Europe/Paris

# --- Secrets ---
INGESTOR_API_TOKEN=replace_with_random_hex_64
INGEST_AUTH_TOKEN=replace_with_random_hex_64

# --- Networking & ports ---
COMPOSE_PROFILES=db,llm,api,ui
CHROMA_PORT=8000
OLLAMA_PORT=11434
STREAMLIT_PORT=8501
INGESTOR_PORT=8001

# --- Reverse proxy (loopback mappings) ---
NGINX_UI_PORT=18501
NGINX_API_PORT=8001
NGINX_CLIENT_MAX_BODY_SIZE=32m
NGINX_UI_UPSTREAM=ui:8501

# --- Ollama models ---
EMBED_MODEL=nomic-embed-text
SMALL_LLM=llama3.2:latest
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# --- Ingest service configuration ---
INGEST_BASE_URL=http://ingestor:8001
INGEST_AUTH_HEADER=Authorization
INGESTOR_IP_ALLOWLIST=
INGEST_CHUNK_SIZE=800
INGEST_CHUNK_OVERLAP=120
MAX_REMOTE_BYTES=26214400
METRICS_ENABLED=true
METRICS_NAMESPACE=rag_local
CHROMA_REQUEST_TIMEOUT=30
OLLAMA_REQUEST_TIMEOUT=60

# --- UI ingestion (API calls from Streamlit) ---
INGEST_API_BASE=http://ingestor:8001
INGEST_API_TOKEN=replace_with_random_hex_64
UI_INGEST_AUTH_HEADER=Authorization
UI_INGEST_AUTH_BEARER_PREFIX=true
UI_DEFAULT_K=4
UI_MAX_K=8
UI_WEBHOOK_TIMEOUT=10
UI_CHROMA_TIMEOUT=30

# --- Multimodal ingest knobs ---
MULTIMODAL_ENABLED=false
MM_PARSER_TIMEOUT=30
MM_MAX_CHARS_PER_CHUNK=1200
MM_CACHE_DIR=/data/mm-cache

# --- Backups & observability ---
PROMETHEUS_SCRAPE_USER=prom_user
PROMETHEUS_SCRAPE_PASSWORD=prom_password

# --- Local source roots (mounted volumes) ---
LOCAL_SOURCE_ROOT=/data/uploads

# --- Google Drive ---
GOOGLE_APPLICATION_CREDENTIALS=/creds/gdrive-sa.json
GOOGLE_DRIVE_TOKEN_PATH=/tmp/google-drive-token.json

# --- Scope par defaut ingestion v2 (LOT43, ingest_v2.py) ---
# Requis : ingest_document echoue fail-closed si l'une manque.
NEXUS_DEFAULT_TENANT=replace_with_real_tenant
NEXUS_DEFAULT_CANDIDAT=replace_with_real_candidat
NEXUS_DEFAULT_VISIBILITY=internal
NEXUS_DEFAULT_SCHOOL_YEAR=replace_with_real_school_year
NEXUS_DEFAULT_PROGRAMME_VERSION=replace_with_real_programme_version

# --- Plan de controle ingestion gouvernee (LOT44b-f, ADR-0025/0029) ---
# Laisser PG_INGESTION_CONTROL_DSN vide desactive tout ce bloc (pont
# /ingest/v2 -> job inactif, gate LOT44c non appelee, api.py reste
# demarrable en retrieval-only). Ne remplir qu'avec un manifest de
# production reellement approuve par la gouvernance — jamais un manifest
# de test place ici.
PG_INGESTION_CONTROL_DSN=
RAG_ENGINE_INGESTION_PROFILES_DIR=
RAG_ENGINE_INGESTION_MANIFEST_PATH=
INGESTION_CONTROL_MIGRATOR_PASSWORD=replace_with_random_hex_64
INGESTION_CONTROL_APP_PASSWORD=replace_with_random_hex_64
INGESTION_WORKER_OWNER=ingestion-worker-1
