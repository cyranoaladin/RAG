# API reverse proxy LOT41U : allowlist exacte, TLS et métriques locales.
limit_req_zone $binary_remote_addr zone=api_v2:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=readiness_v2:10m rate=20r/s;

server {
  listen 80;
  server_name ${RAG_API_EXTERNAL_DOMAIN};

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }
  location ^~ / {
    return 308 https://${RAG_API_EXTERNAL_DOMAIN}$request_uri;
  }
}

server {
  listen 443 ssl http2;
  server_name ${RAG_API_EXTERNAL_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${RAG_API_EXTERNAL_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${RAG_API_EXTERNAL_DOMAIN}/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header X-Frame-Options "DENY" always;
  add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
  add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none';" always;

  location = /health {
    allow 127.0.0.1;
    allow ::1;
    deny all;
    proxy_pass http://127.0.0.1:${NGINX_API_PORT}/health;
    proxy_http_version 1.1;
    proxy_read_timeout 15s;
  }

  location = /metrics {
    allow 127.0.0.1;
    allow ::1;
    deny all;
    proxy_pass http://127.0.0.1:${NGINX_API_PORT}/metrics;
    proxy_http_version 1.1;
  }

  location = /search/v2 {
    limit_req zone=api_v2 burst=40 nodelay;
    proxy_pass http://127.0.0.1:${NGINX_API_PORT}/search/v2;
    proxy_http_version 1.1;
    proxy_read_timeout 60s;
  }

  location = /chat {
    limit_req zone=api_v2 burst=40 nodelay;
    proxy_pass http://127.0.0.1:${NGINX_API_PORT}/chat;
    proxy_http_version 1.1;
    proxy_read_timeout 60s;
  }

  location = /collections/v2 {
    limit_req zone=api_v2 burst=40 nodelay;
    proxy_pass http://127.0.0.1:${NGINX_API_PORT}/collections/v2;
    proxy_http_version 1.1;
    proxy_read_timeout 60s;
  }

  location = /catalogue/v2 {
    limit_req zone=api_v2 burst=40 nodelay;
    proxy_pass http://127.0.0.1:${NGINX_API_PORT}/catalogue/v2;
    proxy_http_version 1.1;
    proxy_read_timeout 60s;
  }

  location = /collections/readiness {
    limit_req zone=readiness_v2 burst=40 nodelay;
    proxy_pass http://127.0.0.1:${NGINX_API_PORT}/collections/readiness;
    proxy_http_version 1.1;
    proxy_read_timeout 60s;
  }

  location = /review/v2/queue {
    limit_req zone=api_v2 burst=20 nodelay;
    proxy_pass http://127.0.0.1:${NGINX_API_PORT}/review/v2/queue;
    proxy_http_version 1.1;
    proxy_read_timeout 60s;
  }

  location = /review/v2/decide {
    limit_req zone=api_v2 burst=10 nodelay;
    proxy_pass http://127.0.0.1:${NGINX_API_PORT}/review/v2/decide;
    proxy_http_version 1.1;
    proxy_read_timeout 60s;
  }

  location = /ingest {
    return 410;
  }
  location ^~ /ingest/ {
    return 410;
  }
  location = /search {
    return 410;
  }
  location ^~ /search/ {
    return 410;
  }
  location ^~ /admin {
    return 410;
  }
  location ^~ /stats {
    return 410;
  }
  location ^~ /eval {
    return 410;
  }
  location ^~ /kb {
    return 410;
  }
  location ^~ /rag {
    return 410;
  }

  location / {
    return 404;
  }
}
