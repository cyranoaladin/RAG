# Candidat public Cockpit : uniquement authentification et recherche citée.
# Activation réservée au cutover signé, jamais aux vhosts historiques.
server {
  listen 80;
  server_name ${RAG_COCKPIT_EXTERNAL_DOMAIN};

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }
  location = / {
    return 308 https://${RAG_COCKPIT_EXTERNAL_DOMAIN}/;
  }
  location / {
    return 404;
  }
}

server {
  listen 443 ssl http2;
  server_name ${RAG_COCKPIT_EXTERNAL_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${RAG_COCKPIT_EXTERNAL_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${RAG_COCKPIT_EXTERNAL_DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers HIGH:!aNULL:!MD5;

  add_header X-Content-Type-Options "nosniff" always;
  add_header Strict-Transport-Security "max-age=63072000" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header X-Frame-Options "DENY" always;
  add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

  proxy_http_version 1.1;
  proxy_set_header Host ${RAG_COCKPIT_EXTERNAL_DOMAIN};
  proxy_set_header Forwarded "";
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Host ${RAG_COCKPIT_EXTERNAL_DOMAIN};
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-Port 443;
  proxy_set_header X-Forwarded-Prefix "";
  proxy_set_header X-Forwarded-Server "";
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Nexus-Identity "";
  proxy_set_header X-RAG-API-Key "";
  proxy_set_header Authorization "";
  proxy_connect_timeout 5s;
  proxy_read_timeout 15s;

  location = / {
    limit_except GET { deny all; }
    proxy_pass http://127.0.0.1:${NGINX_COCKPIT_PORT};
  }
  location ^~ /_next/static/ {
    limit_except GET { deny all; }
    proxy_pass http://127.0.0.1:${NGINX_COCKPIT_PORT};
  }
  location ~ ^/api/auth/(session|csrf|providers|signin|signout|error|callback/credentials)$ {
    limit_except GET POST { deny all; }
    proxy_pass http://127.0.0.1:${NGINX_COCKPIT_PORT};
  }
  location = /api/collections {
    limit_except GET { deny all; }
    proxy_pass http://127.0.0.1:${NGINX_COCKPIT_PORT};
  }
  location = /api/search {
    limit_except POST { deny all; }
    proxy_pass http://127.0.0.1:${NGINX_COCKPIT_PORT};
  }
  location / {
    return 404;
  }
}
