# Runtime Nexus RAG v2 LOT41U — exemple sans secret.
# Copier en .env (mode 0600) puis remplir depuis un gestionnaire de secrets.

# PostgreSQL bootstrap. Le propriétaire sert uniquement à l'initialisation et
# aux migrations ; il n'est jamais transmis à l'API comme DSN runtime.
PGVECTOR_DB=ragdb
PGVECTOR_USER=raguser
PGVECTOR_PASSWORD=
PGVECTOR_PORT=5435

# Identités minimales créées automatiquement sur un volume neuf. Les mots de
# passe distincts (32 caractères minimum) proviennent du gestionnaire de secrets.
PGVECTOR_RETRIEVAL_USER=rag_reader
PGVECTOR_RETRIEVAL_PASSWORD=
PGVECTOR_REVIEW_USER=rag_reviewer
PGVECTOR_REVIEW_PASSWORD=

# DSN des rôles runtime distincts créés ci-dessus sur un volume neuf, ou déjà
# provisionnés et audités sur un volume existant.
# PG_RAG_DSN : SELECT uniquement.
# PG_REVIEW_DSN : SELECT + UPDATE limité au statut de revue.
PG_RAG_DSN=
PG_REVIEW_DSN=

# Autorité BFF et enveloppe interne signée.
RAG_BFF_SERVICE_TOKEN=
NEXUS_INTERNAL_TOKEN_SECRET=
NEXUS_INTERNAL_TOKEN_ISSUER=nexus-cockpit
NEXUS_INTERNAL_TOKEN_AUDIENCE=nexus-rag-engine
NEXUS_SSO_ISSUER=
NEXUS_SSO_AUDIENCE=nexus-cockpit

# Registre des clés porteuses de l'API externe et de leurs portées
# (rag:search, rag:read-source, rag:ingest, rag:admin).
#
# Le RUNTIME accepte exactement une des deux sources, jamais les deux, jamais
# aucune : `RAG_API_CLIENTS` (registre en ligne) ou `RAG_API_CLIENTS_FILE`
# (fichier monté). Deux sources rendraient indécidable celle qui gouverne, et
# zéro source ferait démarrer un service qui ne sait pas qui a le droit
# d'appeler. Le démarrage échoue dans les deux cas.
#
# Le registre ne contient QUE des empreintes SHA-256 de jetons — jamais un
# jeton en clair, et jamais de valeur committée dans le dépôt.
# Forme : [{"client_id":"...","token_sha256":"<64 hex>","scopes":["rag:search"]}]
# Le client présente sa clé dans l'en-tête X-RAG-API-Key (Authorization reste
# réservé au credential machine du BFF).
#
# AVEC `docker-compose.v2.yml` : le Compose monte le registre depuis un magasin
# de secrets et fixe lui-même `RAG_API_CLIENTS_FILE`. Son bloc `environment:`
# n'injecte PAS `RAG_API_CLIENTS` — une valeur donnée ici n'atteindrait donc
# jamais le conteneur et ne créerait aucune seconde source. La seule variable à
# renseigner pour ce Compose est le chemin HÔTE du fichier,
# `RAG_API_CLIENTS_HOST_FILE`.
#
# `RAG_API_CLIENTS` reste documenté pour un déploiement qui n'utilise pas ce
# Compose et injecte le registre en ligne — c'est là, et là seulement, que son
# usage exclut `RAG_API_CLIENTS_FILE`.
RAG_API_CLIENTS=
RAG_API_CLIENTS_HOST_FILE=

# Secret dédié à l'empreinte des requêtes journalisées (HMAC-SHA256). Une
# empreinte sans clé se retrouve par dictionnaire ; celle-ci ne se corrèle
# qu'avec le secret, qui ne quitte pas le déploiement. Distinct de tout
# credential d'appel : une rotation de l'un n'oblige pas l'autre.
RAG_ACCESS_LOG_HMAC_SECRET=

# Artefacts et configuration montés en lecture seule.
RAG_CONFIGS_HOST_DIR=../configs
RAG_EMBEDDING_MODEL_ARTIFACT_HOST_DIR=
RAG_EMBEDDING_MODEL_INVENTORY_SHA256=
RAG_RERANKER_MODEL_ARTIFACT_HOST_DIR=
RAG_RERANKER_MODEL_INVENTORY_SHA256=

# Registre canonique borné des releases actives (2 releases Troisième + 10
# releases multi-niveaux) — SHA-256 externe du fichier release-registry.json.
RAG_RELEASE_REGISTRY_HOST_DIR=../../rag-pedago/data/releases/prerentree_2026_2027
# Chemin DANS le conteneur, sous le montage /app/release (jamais un chemin hôte).
# Le SHA-256 ci-dessous doit désigner exactement le fichier sélectionné.
RAG_RELEASE_REGISTRY_PATH=/app/release/release-registry.json
RAG_RELEASE_REGISTRY_SHA256=

# Fenêtre active/N-1 des manifestes de corpus servables. Le répertoire est
# publié par le pipeline RAG et le digest de l'index est fourni hors artefact.
RAG_SERVABLE_CORPUS_HOST_DIR=
RAG_SERVABLE_CORPUS_INDEX_SHA256=

# Ports loopback et observabilité.
INGESTOR_PORT=8001
PROMETHEUS_PORT=19091
METRICS_ENABLED=true

# Candidat de topologie blue-green uniquement. Sources immuables hors checkout,
# vérifiées par realpath + SHA-256 dans le wrapper final avant toute mutation.
# Les ports de chaque couleur doivent être distincts et rester en loopback.
NEXUS_RELEASE_MATERIAL_ROOT=
# Répertoire hôte hors checkout en 0700. cockpit.env en 0600 ;
# session-redis.acl en 0644 (hash seul, lisible par l'UID non-root Redis après
# montage du fichier uniquement) ; api-clients.json porte seulement des SHA-256.
# Le préflight exige que la clé Cockpit soit inscrite avec rag:search seul.
NEXUS_RUNTIME_SECRETS_ROOT=
NEXUS_INGESTOR_IMAGE_SHA256=
# Ces deux digests appartiennent au candidat public final : Cockpit vient de
# NEXUS-DEPLOYMENT-IMAGE-INVENTORY-V2, Redis de l'image upstream inspectée.
# Ne jamais mettre un digest factice ici ni dans le staging/production.
NEXUS_COCKPIT_IMAGE_SHA256=
NEXUS_REDIS_IMAGE_SHA256=
NEXUS_RELEASE_MATERIAL_MANIFEST_SHA256=
# Couple exact du successeur public A/C ; le SHA de scope vient de l'autorité
# émise pour les onze scopes V3, pas d'un ancien registre V4/V5.
NEXUS_RELEASE_SHA=
NEXUS_PUBLIC_SCOPE_AUTHORITY_SHA256=
NEXUS_SEARCH_PORT=
NEXUS_PROM_PORT=
NEXUS_COCKPIT_PORT=

# Réglages bornés du pool et du retrieval.
INGESTOR_WORKERS=4
PG_POOL_MIN_SIZE=1
PG_POOL_MAX_SIZE=10
PG_POOL_TIMEOUT_S=1.0
PG_CONNECT_TIMEOUT_S=1
PG_STATEMENT_TIMEOUT_MS=3000
PG_LOCK_TIMEOUT_MS=500
# Budget agrégé de toutes les phases SQL d'une requête moteur (< BFF 8000 ms).
PG_DATABASE_BUDGET_MS=6000
RERANK_CACHE_TTL=300
RAG_MIN_COLLECTION_SUBSTANCE_CHUNKS=1
