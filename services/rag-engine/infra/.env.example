# Runtime Nexus RAG v2 LOT41U — exemple sans secret.
# Copier en .env (mode 0600) puis remplir depuis un gestionnaire de secrets.

# PostgreSQL bootstrap. Le propriétaire sert uniquement à l'initialisation et
# aux migrations ; il n'est jamais transmis à l'API comme DSN runtime.
PGVECTOR_DB=ragdb
PGVECTOR_USER=raguser
PGVECTOR_PASSWORD=
PGVECTOR_PORT=5435

# Identités minimales créées automatiquement sur un volume neuf. Les mots de
# passe distincts (32 caractères minimum) proviennent du gestionnaire de secrets.
PGVECTOR_RETRIEVAL_USER=rag_reader
PGVECTOR_RETRIEVAL_PASSWORD=
PGVECTOR_REVIEW_USER=rag_reviewer
PGVECTOR_REVIEW_PASSWORD=
# Rôle produit du plan d'ingestion : INSERT/SELECT sur rag_chunks uniquement.
# Provisionné par la migration 004 ; son absence bloque le démarrage.
PGVECTOR_PUBLISHER_USER=rag_publisher
PGVECTOR_PUBLISHER_PASSWORD=

# DSN des rôles runtime distincts créés ci-dessus sur un volume neuf, ou déjà
# provisionnés et audités sur un volume existant.
# PG_RAG_DSN : SELECT uniquement.
# PG_REVIEW_DSN : SELECT + UPDATE limité au statut de revue.
PG_RAG_DSN=
PG_REVIEW_DSN=

# Autorité BFF et enveloppe interne signée.
RAG_BFF_SERVICE_TOKEN=
NEXUS_INTERNAL_TOKEN_SECRET=
NEXUS_INTERNAL_TOKEN_ISSUER=nexus-cockpit
NEXUS_INTERNAL_TOKEN_AUDIENCE=nexus-rag-engine
NEXUS_SSO_ISSUER=
NEXUS_SSO_AUDIENCE=nexus-cockpit

# Artefacts et configuration montés en lecture seule.
RAG_CONFIGS_HOST_DIR=../configs
RAG_EMBEDDING_MODEL_ARTIFACT_HOST_DIR=
RAG_EMBEDDING_MODEL_INVENTORY_SHA256=
RAG_RERANKER_MODEL_ARTIFACT_HOST_DIR=
RAG_RERANKER_MODEL_INVENTORY_SHA256=

# Registre canonique borné des releases actives (2 releases Troisième + 10
# releases multi-niveaux) — SHA-256 externe du fichier release-registry.json.
RAG_RELEASE_REGISTRY_HOST_DIR=../../rag-pedago/data/releases/prerentree_2026_2027
RAG_RELEASE_REGISTRY_SHA256=

# Ports loopback et observabilité.
INGESTOR_PORT=8001
PROMETHEUS_PORT=19091
METRICS_ENABLED=true

# Réglages bornés du pool et du retrieval.
INGESTOR_WORKERS=4
PG_POOL_MIN_SIZE=1
PG_POOL_MAX_SIZE=10
PG_POOL_TIMEOUT_S=1.0
PG_CONNECT_TIMEOUT_S=1
PG_STATEMENT_TIMEOUT_MS=3000
PG_LOCK_TIMEOUT_MS=500
# Budget agrégé de toutes les phases SQL d'une requête moteur (< BFF 8000 ms).
PG_DATABASE_BUDGET_MS=6000
RERANK_CACHE_TTL=300
RAG_MIN_COLLECTION_SUBSTANCE_CHUNKS=1
