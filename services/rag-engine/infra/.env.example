# pgvector dédié RAG (ADR-0013, A-1)
# Copier en .env et remplir les valeurs avant démarrage.
PG_RAG_PASSWORD=
PG_RAG_PORT=5436

# Token separe pour les routes legacy /admin/*.
# Ne doit pas etre identique a INGESTOR_API_TOKEN / INGEST_AUTH_TOKEN.
LEGACY_ADMIN_API_TOKEN=

# Tokens v2 par role (valeurs a renseigner hors depot).
# Les roles distincts doivent avoir des valeurs de tokens distinctes.
# Les alias d'un meme role peuvent partager la meme valeur.
# Autorise: RAG_REVIEWER_TOKEN == REVIEWER_API_TOKEN.
# Compatibilite: INGESTOR_API_TOKEN et INGEST_AUTH_TOKEN restent des alias ingest_agent v2.
# Recommande: garder RAG_INGEST_AGENT_TOKEN distinct des tokens legacy d'ingestion.
# Interdit: RAG_ADMIN_TOKEN == RAG_STUDENT_TOKEN.
# Une collision entre roles distincts bloque security_v2 en fail-closed 503.
RAG_ADMIN_TOKEN=
RAG_REVIEWER_TOKEN=
REVIEWER_API_TOKEN=
RAG_TEACHER_TOKEN=
RAG_INGEST_AGENT_TOKEN=
INGESTOR_API_TOKEN=
INGEST_AUTH_TOKEN=
RAG_STUDENT_TOKEN=
RAG_BFF_SERVICE_TOKEN=
NEXUS_INTERNAL_TOKEN_SECRET=
NEXUS_INTERNAL_TOKEN_ISSUER=
NEXUS_INTERNAL_TOKEN_AUDIENCE=
NEXUS_SSO_ISSUER=
NEXUS_SSO_AUDIENCE=

# DSN runtime distincts : retrieval SELECT-only et review avec uniquement
# SELECT + UPDATE(review_status). Ne jamais utiliser le DSN owner/migrations.
PG_RAG_DSN=
PG_REVIEW_DSN=
INGESTOR_IP_ALLOWLIST=
INGESTOR_TRUSTED_PROXY_CIDRS=

# Scope par defaut pour l'ingestion v2 (ingest_v2.py, LOT43) — requis,
# ingest_document echoue fail-closed si l'une manque.
NEXUS_DEFAULT_TENANT=
NEXUS_DEFAULT_CANDIDAT=
NEXUS_DEFAULT_VISIBILITY=
NEXUS_DEFAULT_SCHOOL_YEAR=
NEXUS_DEFAULT_PROGRAMME_VERSION=

# Plan de controle ingestion gouvernee (LOT44b-f, ADR-0025/0029).
# Laisser vide = pont /ingest/v2 -> job inactif ET gate LOT44c non appelee
# au demarrage de api.py (retrieval-only inchange). Ne definir
# PG_INGESTION_CONTROL_DSN qu'avec un manifest de production reellement
# approuve par la gouvernance (RAG_ENGINE_INGESTION_MANIFEST_PATH devient
# alors obligatoire) — jamais un manifest de test place ici.
PG_INGESTION_CONTROL_DSN=
RAG_ENGINE_INGESTION_PROFILES_DIR=
RAG_ENGINE_INGESTION_MANIFEST_PATH=
INGESTION_CONTROL_MIGRATOR_PASSWORD=
INGESTION_CONTROL_APP_PASSWORD=
INGESTION_WORKER_OWNER=
