FROM python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93

ENV PYTHONDONTWRITEBYTECODE=1 \
  PYTHONUNBUFFERED=1

WORKDIR /app

# Dépendances du worker d'ingestion gouvernée uniquement — aucun serveur
# HTTP. Worker B charge E5 uniquement depuis un artefact immuable monté
# localement (cf. requirements.ingestion-worker.txt).
COPY services/rag-engine/src/ingestor/requirements.ingestion-worker.txt /tmp/requirements.ingestion-worker.txt
RUN pip install --upgrade pip==26.2 \
 && pip install --no-cache-dir -r /tmp/requirements.ingestion-worker.txt

# Install shared contracts package (after requirements so its pydantic pin wins)
COPY packages/contracts /tmp/nexus-contracts
RUN pip install --no-cache-dir /tmp/nexus-contracts \
 && python -m pip check \
 && rm -rf /tmp/nexus-contracts

# Foyer unique du prédicat structurel « page PDF sans texte » (ADR-0046) :
# l'extracteur l'appelle, il ne le recopie pas. Sa borne pypdf est satisfaite
# par l'épinglage des requirements ci-dessus ; `pip check` le prouve.
COPY packages/pdf-page-policy /tmp/nexus-pdf-page-policy
RUN pip install --no-cache-dir --no-deps /tmp/nexus-pdf-page-policy \
 && python -m pip check \
 && rm -rf /tmp/nexus-pdf-page-policy

# Allowlist applicative : préserve le paquet ``ingestor`` tout en répliquant
# le principe de Dockerfile.ingestor-v2 (COPY nommé, jamais de COPY générique
# du répertoire ingestor/ complet) — pour un périmètre de fichiers
# disjoint : ce worker n'a besoin d'aucun fichier retrieval/review/API
# v2, et l'image v2 (api_v2.py) n'a inversement besoin d'aucun de ces
# modules d'ingestion (allowlist de Dockerfile.ingestor-v2 inchangée).
COPY services/rag-engine/src/ingestor/__init__.py /app/ingestor/__init__.py
COPY services/rag-engine/src/ingestor/ssrf_guard.py /app/ingestor/ssrf_guard.py
COPY services/rag-engine/src/ingestor/ingestion_control/ /app/ingestor/ingestion_control/
COPY services/rag-engine/src/ingestor/ingestion_agents/ /app/ingestor/ingestion_agents/
COPY services/rag-engine/src/ingestor/ingestion_profiles/ /app/ingestor/ingestion_profiles/
COPY services/rag-engine/src/ingestor/ingestion_worker/ /app/ingestor/ingestion_worker/
COPY services/rag-engine/src/ingestor/collection_config.py /app/ingestor/collection_config.py
COPY services/rag-engine/src/ingestor/wave0_release.py /app/ingestor/wave0_release.py
COPY services/rag-engine/src/ingestor/verified_pedagogical_placement.py /app/ingestor/verified_pedagogical_placement.py
COPY services/rag-engine/src/ingestor/embedding_provider.py /app/ingestor/embedding_provider.py
COPY services/rag-engine/src/ingestor/embedding_contract.py /app/ingestor/embedding_contract.py
COPY services/rag-engine/src/ingestor/model_artifact.py /app/ingestor/model_artifact.py
COPY services/rag-engine/src/ingestor/readiness_db.py /app/ingestor/readiness_db.py
COPY services/rag-engine/src/ingestor/governed_publisher_v2.py /app/ingestor/governed_publisher_v2.py
COPY services/rag-engine/src/ingestor/ingest_v2.py /app/ingestor/ingest_v2.py
COPY services/rag-engine/src/ingestor/pedagogical_chunker.py /app/ingestor/pedagogical_chunker.py
COPY services/rag-engine/src/ingestor/publication_chunking.py /app/ingestor/publication_chunking.py
COPY services/rag-engine/src/ingestor/retrieval_hybrid_v2.py /app/ingestor/retrieval_hybrid_v2.py
COPY services/rag-engine/src/ingestor/reranker_contract.py /app/ingestor/reranker_contract.py

# Outil opérateur de création de job (jamais un endpoint HTTP public — cf.
# ADR-0031) : invoqué uniquement via `docker exec` par un opérateur humain
# authentifié sur l'hôte, jamais exposé sur le réseau.
COPY services/rag-engine/src/ingestor/ingestion_worker/create_job_cli.py /app/ingestor/ingestion_worker/create_job_cli.py

# LOT41A/LOT42 (ADR-0032/ADR-0033) — remédiation GATE H1, item I.
#
# Seule la **fonction de décision pure** d'ADR-0025 est copiée ici, avec sa
# configuration de reviewers de confiance. Le transport HTTP vers GitHub est
# assuré par ingestion_control/github_authority.py (httpx, déjà une
# dépendance du worker) : cette image ne contient donc AUCUN binaire `gh`,
# et n'en a jamais besoin.
#
# Le fichier trusted_human_review_github.py (adaptateur `gh api`) est
# volontairement ABSENT : il n'aurait jamais pu s'exécuter ici faute de
# `gh`, et l'installer ajouterait une surface non auditée pour trois
# requêtes GET. La décision d'autorité, elle, reste partagée à l'octet près
# avec la CI — c'est le même fichier, non modifié.
COPY scripts/github/trusted_human_review.py /app/scripts/github/trusted_human_review.py
COPY scripts/github/trusted-reviewers.json /app/scripts/github/trusted-reviewers.json
ENV NEXUS_TRUSTED_REVIEW_MODULE=/app/scripts/github/trusted_human_review.py \
    NEXUS_TRUSTED_REVIEWERS_CONFIG=/app/scripts/github/trusted-reviewers.json

# Aucun secret n'est jamais construit dans cette image (item I) : ni ARG, ni
# ENV portant un jeton, ni fichier de credential. Le jeton GitHub en lecture
# seule est lu à l'exécution depuis NEXUS_GITHUB_TOKEN_FILE (montage de
# secret, cf. docker-compose.ingestion.yml) — jamais depuis une couche.

# Aucun processus HTTP démarré par cette image : pas d'EXPOSE, pas de
# uvicorn. Le point d'entrée est une boucle CLI (ingestor/ingestion_worker/cli.py),
# jamais un serveur — cohérent avec l'exigence de non-exposition publique
# (ADR-0024, ADR-0031).
CMD ["python", "-m", "ingestor.ingestion_worker.cli"]
