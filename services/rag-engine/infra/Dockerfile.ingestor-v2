FROM python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93

ENV PYTHONDONTWRITEBYTECODE=1 \
  PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
  curl \
  libgomp1 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dépendances du runtime lecture/revue uniquement.
COPY services/rag-engine/src/ingestor/requirements.runtime-v2.txt /tmp/requirements.runtime-v2.txt
RUN pip install --upgrade pip==26.2 \
 && pip install --no-cache-dir -r /tmp/requirements.runtime-v2.txt

# Install shared contracts package (after requirements so its pydantic pin wins)
COPY packages/contracts /tmp/nexus-contracts
RUN pip install --no-cache-dir /tmp/nexus-contracts \
 && python -m pip check \
 && rm -rf /tmp/nexus-contracts

# Allowlist applicative : aucun writer, parseur ou client de source distante.
COPY services/rag-engine/src/ingestor/api_v2.py /app/api_v2.py
COPY services/rag-engine/src/ingestor/collection_config.py /app/collection_config.py
COPY services/rag-engine/src/ingestor/embedding_contract.py /app/embedding_contract.py
COPY services/rag-engine/src/ingestor/identity_v2.py /app/identity_v2.py
COPY services/rag-engine/src/ingestor/metrics.py /app/metrics.py
COPY services/rag-engine/src/ingestor/pg_pool.py /app/pg_pool.py
COPY services/rag-engine/src/ingestor/retrieval_hybrid_v2.py /app/retrieval_hybrid_v2.py
COPY services/rag-engine/src/ingestor/retrieval_pg_v2.py /app/retrieval_pg_v2.py
COPY services/rag-engine/src/ingestor/retrieval_scope_v2.py /app/retrieval_scope_v2.py
COPY services/rag-engine/src/ingestor/retrieval_v2_endpoint.py /app/retrieval_v2_endpoint.py
COPY services/rag-engine/src/ingestor/review_v2_endpoint.py /app/review_v2_endpoint.py
COPY services/rag-engine/src/ingestor/reranker_contract.py /app/reranker_contract.py
COPY services/rag-engine/src/ingestor/schema_readiness_v2.py /app/schema_readiness_v2.py
COPY services/rag-engine/src/ingestor/security_v2.py /app/security_v2.py
COPY services/rag-engine/infra/postgres/migrations/ /app/migrations/

EXPOSE 8001

CMD ["uvicorn", "api_v2:app", "--host", "0.0.0.0", "--port", "8001"]
