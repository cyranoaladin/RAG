{
  "$defs": {
    "Audience": {
      "enum": [
        "libre",
        "aefe",
        "tous"
      ],
      "title": "Audience",
      "type": "string"
    },
    "Candidat": {
      "enum": [
        "scolarise",
        "individuel",
        "libre",
        "cned_reglemente",
        "cned_libre",
        "aefe",
        "both"
      ],
      "title": "Candidat",
      "type": "string"
    },
    "Niveau": {
      "enum": [
        "troisieme",
        "seconde",
        "premiere",
        "terminale",
        "cycle4",
        "lycee_gt",
        "voie_generale",
        "voie_technologique"
      ],
      "title": "Niveau",
      "type": "string"
    },
    "ResourceScope": {
      "additionalProperties": false,
      "description": "Scope gouverné complet — obligatoire et fail-closed.\n\nReprend exactement les dix dimensions de scope déjà gouvernées côté\nrag-engine (colonnes ``rag_chunks`` introduites en LOT41,\n``services/rag-engine/infra/postgres/migrations/003_profile_filtering.sql``).\nAucun champ n'a de valeur par défaut : un scope incomplet ne peut pas\nêtre construit, jamais deviné silencieusement.",
      "properties": {
        "audience": {
          "items": {
            "$ref": "#/$defs/Audience"
          },
          "minItems": 1,
          "title": "Audience",
          "type": "array"
        },
        "candidat": {
          "$ref": "#/$defs/Candidat"
        },
        "collection": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Collection",
          "type": "string"
        },
        "matiere": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Matiere",
          "type": "string"
        },
        "niveau": {
          "$ref": "#/$defs/Niveau"
        },
        "programme_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Programme Version",
          "type": "string"
        },
        "school_year": {
          "pattern": "^\\d{4}-\\d{4}$",
          "title": "School Year",
          "type": "string"
        },
        "tenant": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Tenant",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "public",
            "internal",
            "restricted",
            "private"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "voie": {
          "$ref": "#/$defs/Voie"
        }
      },
      "required": [
        "tenant",
        "collection",
        "niveau",
        "voie",
        "matiere",
        "candidat",
        "audience",
        "visibility",
        "school_year",
        "programme_version"
      ],
      "title": "ResourceScope",
      "type": "object"
    },
    "Voie": {
      "enum": [
        "college",
        "generale",
        "technologique",
        "professionnelle",
        "aefe",
        "unknown"
      ],
      "title": "Voie",
      "type": "string"
    }
  },
  "$id": "https://nexusreussite.academy/contracts/v0.5/coverage-snapshot.json",
  "additionalProperties": false,
  "description": "Instantané de couverture thématique d'une collection sur une période.",
  "properties": {
    "average_quality": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Average Quality"
    },
    "covered_topics": {
      "items": {
        "type": "string"
      },
      "title": "Covered Topics",
      "type": "array"
    },
    "expected_topics": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Expected Topics",
      "type": "array"
    },
    "gaps": {
      "items": {
        "type": "string"
      },
      "title": "Gaps",
      "type": "array"
    },
    "insufficient_topics": {
      "items": {
        "type": "string"
      },
      "title": "Insufficient Topics",
      "type": "array"
    },
    "period_end": {
      "format": "date-time",
      "title": "Period End",
      "type": "string"
    },
    "period_start": {
      "format": "date-time",
      "title": "Period Start",
      "type": "string"
    },
    "recommended_next_queries": {
      "items": {
        "type": "string"
      },
      "title": "Recommended Next Queries",
      "type": "array"
    },
    "resources_per_topic": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Resources Per Topic",
      "type": "object"
    },
    "scope": {
      "$ref": "#/$defs/ResourceScope"
    },
    "snapshot_id": {
      "format": "uuid",
      "title": "Snapshot Id",
      "type": "string"
    },
    "stale_resources": {
      "default": 0,
      "minimum": 0,
      "title": "Stale Resources",
      "type": "integer"
    }
  },
  "required": [
    "snapshot_id",
    "scope",
    "period_start",
    "period_end",
    "expected_topics"
  ],
  "title": "CoverageSnapshot",
  "type": "object"
}
