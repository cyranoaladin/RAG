# NEXUS-AUTHORITY-UNIQUENESS-BASELINE-V1
#
# Un concept, une autorite. Ce fichier epingle l etat CONNU. Le controle
# echoue quand un fichier NON epingle se met a decider, pas quand la dette
# existante reste stable : figer un objectif non atteint rendrait le controle
# rouge en permanence, et un controle toujours rouge n est plus lu.
#
# Retirer une ligne est un progres et doit etre fait dans le lot qui converge.
# En ajouter une exige de dire pourquoi une seconde autorite est acceptable.
#
# Format : REGLE<TAB>chemin
# Lignes vides et lignes commencant par # ignorees.

# --- R1 : la matrice de servabilite est DERIVEE, jamais une autorite -----
# Seul son constructeur la lit. Aucun chemin de production ne doit consommer
# son verdict comme source de verite.
MATRIX_READER	services/rag-pedago/scripts/construire_matrice_servabilite.py
# L evaluateur de readiness lit les compteurs de la matrice pour en RENDRE
# COMPTE, jamais pour decider qu un contenu est servable. Il ne rend aucun
# verdict de servabilite, et il ne peut que REFUSER le go-live : une epreuve le
# tient (test_le_lecteur_de_readiness_ne_peut_que_refuser).
MATRIX_READER	scripts/go_live/check_go_live_readiness.py

# --- R2 : la politique d actualite n a aucun lecteur de production -------
# Elle est applied=false. Un lecteur de production l appliquerait de fait,
# sans passer par l ADR qui l adopte.
#
# L evaluateur de readiness lit le champ `applied` pour DIRE qu il est faux et
# bloquer le go-live. Lire un drapeau pour signaler qu il n est pas leve est
# l inverse de l appliquer : ce lecteur ne peut jamais rendre la politique
# effective, il peut seulement refuser tant qu elle ne l est pas.
CURRENTNESS_POLICY_READER	scripts/go_live/check_go_live_readiness.py

# --- R4 : producteur AuthorizationSetV2 -----------------------------------
# EXACTEMENT un producteur canonique hors du contrat. Il DERIVE les contenus
# autorises des placements de la release ; il ne ressaisit rien. Un second
# producteur pourrait deriver autrement, et deux autorisations qui divergent
# sont pires qu une seule imparfaite.
AUTHORIZATION_V2_PRODUCER	packages/release-chain/src/nexus_release_chain/authorization_v2_producer.py

# --- R4b : chargeur d autorisation ----------------------------------------
# EXACTEMENT un chargeur. Il accepte les deux protocoles et prefere la V2 ; il
# ne verifie rien. Neuf consommateurs qui choisiraient chacun entre V1 et V2
# finiraient par ne pas choisir pareil, et le meme document serait autorise ici
# et refuse la.
AUTHORIZATION_LOADER	packages/contracts/src/nexus_contracts/authorization_loader.py

# --- R5 : selection de release --------------------------------------------
# select_release_authority est le mecanisme contractuel.
# compute_promoted_content_set.py superpose une SECONDE matrice de
# precedence : c est une dette reconnue, epinglee ici, a resorber.
RELEASE_SELECTION	packages/release-chain/src/nexus_release_chain/release_readiness.py
RELEASE_SELECTION	packages/release-chain/src/nexus_release_chain/deployment_binding.py
RELEASE_SELECTION	services/rag-engine/src/ingestor/retrieval_v2_endpoint.py
RELEASE_SELECTION	scripts/qualification/compute_promoted_content_set.py
# L evaluateur de readiness NOMME `select_release_authority` dans sa
# documentation, pour dire a quelle autorite il delegue. Il ne selectionne
# aucune release : il invoque le calculateur canonique et lit sa sortie. Une
# epreuve le tient sur le corps de la fonction — ni balayage de fichiers, ni
# redefinition d une empreinte, ni matrice de precedence.
# (test_le_gate_ne_definit_pas_lui_meme_l_ensemble_promu)
RELEASE_SELECTION	scripts/go_live/check_go_live_readiness.py
