{
  "$defs": {
    "Audience": {
      "enum": [
        "libre",
        "aefe",
        "tous"
      ],
      "title": "Audience",
      "type": "string"
    },
    "BootstrapChunk": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Chunk Id",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/ChunkLocator"
        }
      },
      "required": [
        "chunk_id",
        "locator"
      ],
      "title": "BootstrapChunk",
      "type": "object"
    },
    "BootstrapPlacement": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "items": {
            "$ref": "#/$defs/Audience"
          },
          "minItems": 1,
          "title": "Audience",
          "type": "array"
        },
        "candidat": {
          "$ref": "#/$defs/Candidat"
        },
        "collection": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Collection",
          "type": "string"
        },
        "matiere": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Matiere",
          "type": "string"
        },
        "niveau": {
          "$ref": "#/$defs/Niveau"
        },
        "programme_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Programme Version",
          "type": "string"
        },
        "school_year": {
          "pattern": "^\\d{4}-\\d{4}$",
          "title": "School Year",
          "type": "string"
        },
        "statut_enseignement": {
          "$ref": "#/$defs/StatutEnseignement"
        },
        "tenant": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Tenant",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "public",
            "internal",
            "restricted",
            "private"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "voie": {
          "$ref": "#/$defs/Voie"
        }
      },
      "required": [
        "tenant",
        "collection",
        "niveau",
        "voie",
        "matiere",
        "candidat",
        "audience",
        "visibility",
        "school_year",
        "programme_version",
        "statut_enseignement"
      ],
      "title": "BootstrapPlacement",
      "type": "object"
    },
    "BootstrapResourceVersion": {
      "additionalProperties": false,
      "properties": {
        "chunks": {
          "items": {
            "$ref": "#/$defs/BootstrapChunk"
          },
          "minItems": 1,
          "title": "Chunks",
          "type": "array"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "mime_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Mime Type",
          "type": "string"
        },
        "official": {
          "title": "Official",
          "type": "boolean"
        },
        "placements": {
          "items": {
            "$ref": "#/$defs/BootstrapPlacement"
          },
          "minItems": 1,
          "title": "Placements",
          "type": "array"
        },
        "rag_artifact_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rag Artifact Id",
          "type": "string"
        },
        "resource_id": {
          "format": "uuid",
          "title": "Resource Id",
          "type": "string"
        },
        "resource_version_id": {
          "format": "uuid",
          "title": "Resource Version Id",
          "type": "string"
        },
        "rights": {
          "$ref": "#/$defs/Rights"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source_kind": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Kind",
          "type": "string"
        },
        "source_label": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Label",
          "type": "string"
        },
        "source_uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Source Uri",
          "type": "string"
        },
        "type_doc": {
          "$ref": "#/$defs/TypeDoc"
        }
      },
      "required": [
        "resource_id",
        "resource_version_id",
        "content_sha256",
        "rag_artifact_id",
        "size_bytes",
        "mime_type",
        "source_label",
        "source_uri",
        "rights",
        "official",
        "source_kind",
        "type_doc",
        "placements",
        "chunks"
      ],
      "title": "BootstrapResourceVersion",
      "type": "object"
    },
    "Candidat": {
      "enum": [
        "scolarise",
        "individuel",
        "libre",
        "cned_reglemente",
        "cned_libre",
        "aefe",
        "both"
      ],
      "title": "Candidat",
      "type": "string"
    },
    "ChunkLocator": {
      "additionalProperties": false,
      "properties": {
        "chunk_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Index"
        },
        "end_char": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Char"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "page_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page End"
        },
        "page_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Start"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "start_char": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Char"
        }
      },
      "title": "ChunkLocator",
      "type": "object"
    },
    "Niveau": {
      "enum": [
        "quatrieme",
        "troisieme",
        "seconde",
        "premiere",
        "terminale",
        "cycle4",
        "lycee_gt",
        "voie_generale",
        "voie_technologique"
      ],
      "title": "Niveau",
      "type": "string"
    },
    "Rights": {
      "enum": [
        "officiel_public",
        "public_allowed",
        "nexus_proprietaire",
        "usage_interne",
        "student_private",
        "parent_private",
        "commercial_confidential",
        "restricted",
        "unknown"
      ],
      "title": "Rights",
      "type": "string"
    },
    "StatutEnseignement": {
      "enum": [
        "tronc_commun",
        "enseignement_commun",
        "specialite",
        "eds",
        "option",
        "maths_complementaires",
        "maths_expertes",
        "snt",
        "enseignement_scientifique",
        "emc",
        "atelier",
        "stage",
        "remediation",
        "examen",
        "unknown"
      ],
      "title": "StatutEnseignement",
      "type": "string"
    },
    "TypeDoc": {
      "enum": [
        "programme_officiel",
        "ressource_officielle",
        "cours",
        "fiche_synthese",
        "fiche_methode",
        "td",
        "tp",
        "exercice",
        "exercice_corrige",
        "devoir",
        "devoir_corrige",
        "evaluation",
        "evaluation_corrigee",
        "bac_blanc",
        "brevet_blanc",
        "annale",
        "sujet_zero",
        "corrige",
        "bareme",
        "grille_evaluation",
        "grille_grand_oral",
        "oral",
        "diaporama",
        "latex",
        "notebook",
        "code",
        "image",
        "scan",
        "copie",
        "rapport",
        "referentiel",
        "modalite_examen",
        "autre"
      ],
      "title": "TypeDoc",
      "type": "string"
    },
    "Voie": {
      "enum": [
        "college",
        "generale",
        "technologique",
        "professionnelle",
        "aefe",
        "unknown"
      ],
      "title": "Voie",
      "type": "string"
    }
  },
  "$id": "https://nexusreussite.academy/contracts/v0.5/resource-registry-bootstrap-v1.json",
  "additionalProperties": false,
  "properties": {
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "inventory_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Inventory Sha256",
      "type": "string"
    },
    "package_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Package Version",
      "type": "string"
    },
    "producer_commit": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "title": "Producer Commit",
      "type": "string"
    },
    "producer_repository": {
      "maxLength": 200,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "title": "Producer Repository",
      "type": "string"
    },
    "protocol_version": {
      "const": "1",
      "title": "Protocol Version",
      "type": "string"
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/BootstrapResourceVersion"
      },
      "minItems": 1,
      "title": "Resources",
      "type": "array"
    },
    "source_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Snapshot Sha256",
      "type": "string"
    }
  },
  "required": [
    "protocol_version",
    "producer_repository",
    "producer_commit",
    "package_version",
    "source_snapshot_sha256",
    "generated_at",
    "resources",
    "inventory_sha256"
  ],
  "title": "ResourceRegistryBootstrap",
  "type": "object"
}
