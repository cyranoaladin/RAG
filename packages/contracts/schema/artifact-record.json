{
  "$defs": {
    "Audience": {
      "enum": [
        "libre",
        "aefe",
        "tous"
      ],
      "title": "Audience",
      "type": "string"
    },
    "Candidat": {
      "enum": [
        "scolarise",
        "individuel",
        "libre",
        "cned_reglemente",
        "cned_libre",
        "aefe",
        "both"
      ],
      "title": "Candidat",
      "type": "string"
    },
    "Niveau": {
      "enum": [
        "troisieme",
        "seconde",
        "premiere",
        "terminale",
        "cycle4",
        "lycee_gt",
        "voie_generale",
        "voie_technologique"
      ],
      "title": "Niveau",
      "type": "string"
    },
    "ResourceScope": {
      "additionalProperties": false,
      "description": "Scope gouverné complet — obligatoire et fail-closed.\n\nReprend exactement les dix dimensions de scope déjà gouvernées côté\nrag-engine (colonnes ``rag_chunks`` introduites en LOT41,\n``services/rag-engine/infra/postgres/migrations/003_profile_filtering.sql``).\nAucun champ n'a de valeur par défaut : un scope incomplet ne peut pas\nêtre construit, jamais deviné silencieusement.",
      "properties": {
        "audience": {
          "items": {
            "$ref": "#/$defs/Audience"
          },
          "minItems": 1,
          "title": "Audience",
          "type": "array"
        },
        "candidat": {
          "$ref": "#/$defs/Candidat"
        },
        "collection": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Collection",
          "type": "string"
        },
        "matiere": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Matiere",
          "type": "string"
        },
        "niveau": {
          "$ref": "#/$defs/Niveau"
        },
        "programme_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Programme Version",
          "type": "string"
        },
        "school_year": {
          "pattern": "^\\d{4}-\\d{4}$",
          "title": "School Year",
          "type": "string"
        },
        "tenant": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Tenant",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "public",
            "internal",
            "restricted",
            "private"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "voie": {
          "$ref": "#/$defs/Voie"
        }
      },
      "required": [
        "tenant",
        "collection",
        "niveau",
        "voie",
        "matiere",
        "candidat",
        "audience",
        "visibility",
        "school_year",
        "programme_version"
      ],
      "title": "ResourceScope",
      "type": "object"
    },
    "Rights": {
      "enum": [
        "officiel_public",
        "public_allowed",
        "nexus_proprietaire",
        "usage_interne",
        "student_private",
        "parent_private",
        "commercial_confidential",
        "restricted",
        "unknown"
      ],
      "title": "Rights",
      "type": "string"
    },
    "Voie": {
      "enum": [
        "college",
        "generale",
        "technologique",
        "professionnelle",
        "aefe",
        "unknown"
      ],
      "title": "Voie",
      "type": "string"
    }
  },
  "$id": "https://nexusreussite.academy/contracts/v0.5/artifact-record.json",
  "additionalProperties": false,
  "description": "Artefact téléchargé et son empreinte — ancre de déduplication/version.",
  "properties": {
    "artifact_id": {
      "format": "uuid",
      "title": "Artifact Id",
      "type": "string"
    },
    "collected_at": {
      "format": "date-time",
      "title": "Collected At",
      "type": "string"
    },
    "domain": {
      "minLength": 1,
      "title": "Domain",
      "type": "string"
    },
    "extracted_text_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extracted Text Ref"
    },
    "final_url": {
      "minLength": 1,
      "title": "Final Url",
      "type": "string"
    },
    "license": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License"
    },
    "mime_declared": {
      "minLength": 1,
      "title": "Mime Declared",
      "type": "string"
    },
    "mime_detected": {
      "minLength": 1,
      "title": "Mime Detected",
      "type": "string"
    },
    "original_url": {
      "minLength": 1,
      "title": "Original Url",
      "type": "string"
    },
    "pages_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pages Count"
    },
    "publisher": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publisher"
    },
    "resource_id": {
      "format": "uuid",
      "title": "Resource Id",
      "type": "string"
    },
    "rights_status": {
      "$ref": "#/$defs/Rights"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ResourceScope"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Version"
    }
  },
  "required": [
    "artifact_id",
    "resource_id",
    "run_id",
    "scope",
    "sha256",
    "size_bytes",
    "mime_declared",
    "mime_detected",
    "original_url",
    "final_url",
    "collected_at",
    "domain",
    "rights_status"
  ],
  "title": "ArtifactRecord",
  "type": "object"
}
