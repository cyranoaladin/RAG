{
  "$defs": {
    "Audience": {
      "enum": [
        "libre",
        "aefe",
        "tous"
      ],
      "title": "Audience",
      "type": "string"
    },
    "Candidat": {
      "enum": [
        "scolarise",
        "individuel",
        "libre",
        "cned_reglemente",
        "cned_libre",
        "aefe",
        "both"
      ],
      "title": "Candidat",
      "type": "string"
    },
    "Niveau": {
      "enum": [
        "troisieme",
        "seconde",
        "premiere",
        "terminale",
        "cycle4",
        "lycee_gt",
        "voie_generale",
        "voie_technologique"
      ],
      "title": "Niveau",
      "type": "string"
    },
    "ResourceScope": {
      "additionalProperties": false,
      "description": "Scope gouverné complet — obligatoire et fail-closed.\n\nReprend exactement les dix dimensions de scope déjà gouvernées côté\nrag-engine (colonnes ``rag_chunks`` introduites en LOT41,\n``services/rag-engine/infra/postgres/migrations/003_profile_filtering.sql``).\nAucun champ n'a de valeur par défaut : un scope incomplet ne peut pas\nêtre construit, jamais deviné silencieusement.",
      "properties": {
        "audience": {
          "items": {
            "$ref": "#/$defs/Audience"
          },
          "minItems": 1,
          "title": "Audience",
          "type": "array"
        },
        "candidat": {
          "$ref": "#/$defs/Candidat"
        },
        "collection": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Collection",
          "type": "string"
        },
        "matiere": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Matiere",
          "type": "string"
        },
        "niveau": {
          "$ref": "#/$defs/Niveau"
        },
        "programme_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Programme Version",
          "type": "string"
        },
        "school_year": {
          "pattern": "^\\d{4}-\\d{4}$",
          "title": "School Year",
          "type": "string"
        },
        "tenant": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Tenant",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "public",
            "internal",
            "restricted",
            "private"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "voie": {
          "$ref": "#/$defs/Voie"
        }
      },
      "required": [
        "tenant",
        "collection",
        "niveau",
        "voie",
        "matiere",
        "candidat",
        "audience",
        "visibility",
        "school_year",
        "programme_version"
      ],
      "title": "ResourceScope",
      "type": "object"
    },
    "Voie": {
      "enum": [
        "college",
        "generale",
        "technologique",
        "professionnelle",
        "aefe",
        "unknown"
      ],
      "title": "Voie",
      "type": "string"
    }
  },
  "$id": "https://nexusreussite.academy/contracts/v0.5/ingestion-run.json",
  "additionalProperties": false,
  "description": "Run d'ingestion — s'arrête à ``resources_retrieval_eligible``.\n\nAucun compteur ``resources_published`` : la publication produit est hors\npérimètre de LOT44a (cf. ``nexus_contracts.resource_state``).",
  "properties": {
    "code_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code Version"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "jobs_total": {
      "default": 0,
      "minimum": 0,
      "title": "Jobs Total",
      "type": "integer"
    },
    "mode": {
      "const": "auto_stage",
      "default": "auto_stage",
      "title": "Mode",
      "type": "string"
    },
    "profile_version": {
      "minLength": 1,
      "title": "Profile Version",
      "type": "string"
    },
    "resources_accepted": {
      "default": 0,
      "minimum": 0,
      "title": "Resources Accepted",
      "type": "integer"
    },
    "resources_discovered": {
      "default": 0,
      "minimum": 0,
      "title": "Resources Discovered",
      "type": "integer"
    },
    "resources_fetched": {
      "default": 0,
      "minimum": 0,
      "title": "Resources Fetched",
      "type": "integer"
    },
    "resources_needs_review": {
      "default": 0,
      "minimum": 0,
      "title": "Resources Needs Review",
      "type": "integer"
    },
    "resources_quarantined": {
      "default": 0,
      "minimum": 0,
      "title": "Resources Quarantined",
      "type": "integer"
    },
    "resources_rejected": {
      "default": 0,
      "minimum": 0,
      "title": "Resources Rejected",
      "type": "integer"
    },
    "resources_retrieval_eligible": {
      "default": 0,
      "minimum": 0,
      "title": "Resources Retrieval Eligible",
      "type": "integer"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ResourceScope"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "default": "planned",
      "enum": [
        "planned",
        "running",
        "succeeded",
        "failed",
        "partial",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "trigger": {
      "enum": [
        "scheduled",
        "manual"
      ],
      "title": "Trigger",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "scope",
    "profile_version",
    "trigger"
  ],
  "title": "IngestionRun",
  "type": "object"
}
