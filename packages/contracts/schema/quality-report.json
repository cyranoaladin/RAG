    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ResourceScope"
    },
    "structure_score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Structure Score",
      "type": "number"
    },
    "topic_coverage": {
      "maximum": 1,
