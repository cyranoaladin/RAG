      "type": "number"
    },
    "niveau_conformity": {
      "title": "Niveau Conformity",
      "type": "boolean"
    },
    "pii_detected": {
      "title": "Pii Detected",
      "type": "boolean"
    },
    "programme_conformity": {
      "title": "Programme Conformity",
      "type": "boolean"
    },
    "readability": {
      "maximum": 1,
      "minimum": 0,
