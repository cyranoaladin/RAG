      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "extraction_quality": {
      "maximum": 1,
      "minimum": 0,
      "title": "Extraction Quality",
      "type": "number"
    },
    "language_detected": {
      "minLength": 1,
      "title": "Language Detected",
      "type": "string"
    },
    "matiere_conformity": {
      "title": "Matiere Conformity",
      "type": "boolean"
    },
    "metadata_quality": {
