      "title": "Topic Coverage",
      "type": "number"
    },
    "voie_conformity": {
      "title": "Voie Conformity",
      "type": "boolean"
    }
  },
  "required": [
    "report_id",
    "resource_id",
    "run_id",
    "scope",
    "extraction_quality",
    "readability",
    "language_detected",
    "structure_score",
    "niveau_conformity",
    "voie_conformity",
    "matiere_conformity",
    "programme_conformity",
    "topic_coverage",
    "relevance_score",
    "pii_detected",
    "duplicate_detected",
    "metadata_quality",
    "rights_status",
    "evaluated_at"
  ],
  "title": "QualityReport",
  "type": "object"
}
