# Deny all by default.
**

# Keep this file visible to Docker.
!.dockerignore

# Required for Dockerfile.ingestor-v2.
!services/
!services/rag-engine/
!services/rag-engine/infra/
!services/rag-engine/infra/Dockerfile.ingestor-v2
!services/rag-engine/infra/postgres/
!services/rag-engine/infra/postgres/migrations/
!services/rag-engine/infra/postgres/migrations/**
!services/rag-engine/infra/postgres/schema_head_003_fingerprints.env
!services/rag-engine/infra/postgres/schema_head_003_columns.tsv

# Required v2 read/review modules only.
!services/rag-engine/src/
!services/rag-engine/src/ingestor/
!services/rag-engine/src/ingestor/requirements.runtime-v2.txt
!services/rag-engine/src/ingestor/api_v2.py
!services/rag-engine/src/ingestor/collection_config.py
!services/rag-engine/src/ingestor/embedding_contract.py
!services/rag-engine/src/ingestor/identity_v2.py
!services/rag-engine/src/ingestor/metrics.py
!services/rag-engine/src/ingestor/model_artifact.py
!services/rag-engine/src/ingestor/pg_pool.py
!services/rag-engine/src/ingestor/readiness_db.py
!services/rag-engine/src/ingestor/retrieval_hybrid_v2.py
!services/rag-engine/src/ingestor/retrieval_pg_v2.py
!services/rag-engine/src/ingestor/retrieval_readiness_v2.py
!services/rag-engine/src/ingestor/retrieval_scope_v2.py
!services/rag-engine/src/ingestor/retrieval_v2_endpoint.py
!services/rag-engine/src/ingestor/review_v2_endpoint.py
!services/rag-engine/src/ingestor/review_readiness_v2.py
!services/rag-engine/src/ingestor/reranker_contract.py
!services/rag-engine/src/ingestor/schema_readiness_v2.py
!services/rag-engine/src/ingestor/security_v2.py

# Required UI image inputs. Keep this allowlist narrow because the Compose build
# context is the repository root.
!services/rag-engine/requirements.lock
!services/rag-engine/src/ui/
!services/rag-engine/src/ui/**

# Required shared contracts package.
!packages/
!packages/contracts/
!packages/contracts/**

# Required for the UI image dependency smoke.
!scripts/
!scripts/e2e/
!scripts/e2e/smoke-ui-runtime-imports.sh

# Hard-deny sensitive and heavy files even if they appear under allowed paths.
.git
.git/**
**/.git
**/.git/**

.env
.env.*
**/.env
**/.env.*
**/*secret*
**/*secrets*
**/*credential*
**/*credentials*
**/creds
**/creds/**
**/private
**/private/**
**/*.pem
**/*.key
**/*.p12
**/*.pfx

**/node_modules
**/node_modules/**
**/.venv
**/.venv/**
**/venv
**/venv/**
**/__pycache__
**/__pycache__/**
**/.pytest_cache
**/.pytest_cache/**
**/.mypy_cache
**/.mypy_cache/**
**/.ruff_cache
**/.ruff_cache/**
**/.cache
**/.cache/**

**/data
**/data/**
**/uploads
**/uploads/**
**/volumes
**/volumes/**
**/backups
**/backups/**
**/backup
**/backup/**
**/corpus
**/corpus/**
**/artifacts
**/artifacts/**
**/dist
**/dist/**
**/build
**/build/**
