# Deny all by default.
**

# Keep this file visible to Docker.
!.dockerignore

# Required for Dockerfile.ingestor-v2.
!services/
!services/rag-engine/
!services/rag-engine/infra/
!services/rag-engine/infra/Dockerfile.ingestor-v2
!services/rag-engine/infra/postgres/
!services/rag-engine/infra/postgres/migrations/
!services/rag-engine/infra/postgres/migrations/**
!services/rag-engine/infra/postgres/schema_head_003_fingerprints.env
!services/rag-engine/infra/postgres/schema_head_003_columns.tsv

# Required v2 read/review modules only.
!services/rag-engine/src/
!services/rag-engine/src/ingestor/
!services/rag-engine/src/ingestor/requirements.runtime-v2.txt
!services/rag-engine/src/ingestor/api_v2.py
!services/rag-engine/src/ingestor/collection_config.py
!services/rag-engine/src/ingestor/embedding_contract.py
!services/rag-engine/src/ingestor/identity_v2.py
!services/rag-engine/src/ingestor/inference_runtime.py
!services/rag-engine/src/ingestor/metrics.py
!services/rag-engine/src/ingestor/model_artifact.py
!services/rag-engine/src/ingestor/pg_pool.py
!services/rag-engine/src/ingestor/readiness_db.py
!services/rag-engine/src/ingestor/retrieval_contract_adapter.py
!services/rag-engine/src/ingestor/retrieval_hybrid_v2.py
!services/rag-engine/src/ingestor/retrieval_pg_v2.py
!services/rag-engine/src/ingestor/retrieval_readiness_v2.py
!services/rag-engine/src/ingestor/retrieval_scope_v2.py
!services/rag-engine/src/ingestor/retrieval_v2_endpoint.py
!services/rag-engine/src/ingestor/review_v2_endpoint.py
!services/rag-engine/src/ingestor/review_readiness_v2.py
!services/rag-engine/src/ingestor/reranker_contract.py
!services/rag-engine/src/ingestor/schema_readiness_v2.py
!services/rag-engine/src/ingestor/security_v2.py

# Required for Dockerfile.ingestion-worker (LOT44f/ADR-0031). Explicit
# allowlist entries added for clarity/robustness (remédiation revue PR#90,
# Cubic P1) — the parent-directory re-includes above (!services/rag-engine/
# src/ingestor/) already made these importable in practice (moby's
# dockerignore pattern matcher re-includes new files under a directory
# once that directory itself is un-ignored), verified empirically via a
# real `docker compose build`, but relying on that implicit behavior is
# fragile for future maintainers — explicit entries remove the ambiguity.
!services/rag-engine/src/ingestor/requirements.ingestion-worker.txt
!services/rag-engine/src/ingestor/ssrf_guard.py
!services/rag-engine/src/ingestor/ingestion_control/
!services/rag-engine/src/ingestor/ingestion_control/**
!services/rag-engine/src/ingestor/ingestion_agents/
!services/rag-engine/src/ingestor/ingestion_agents/**
!services/rag-engine/src/ingestor/ingestion_profiles/
!services/rag-engine/src/ingestor/ingestion_profiles/**
!services/rag-engine/src/ingestor/ingestion_worker/
!services/rag-engine/src/ingestor/ingestion_worker/**
!services/rag-engine/infra/Dockerfile.ingestion-worker

# Required authoritative taxonomy artefact for catalogue verification.
!services/rag-pedago/
!services/rag-pedago/taxonomy/
!services/rag-pedago/taxonomy/**

# Required UI image inputs. Keep this allowlist narrow because the Compose build
# context is the repository root.
!services/rag-engine/requirements.lock
!services/rag-engine/src/ui/
!services/rag-engine/src/ui/**

# Required shared contracts package.
!packages/
!packages/contracts/
!packages/contracts/**

# Required for the UI image dependency smoke.
!scripts/
!scripts/e2e/
!scripts/e2e/smoke-ui-runtime-imports.sh

# Hard-deny sensitive and heavy files even if they appear under allowed paths.
.git
.git/**
**/.git
**/.git/**

.env
.env.*
**/.env
**/.env.*
**/*secret*
**/*secrets*
**/*credential*
**/*credentials*
**/creds
**/creds/**
**/private
**/private/**
**/*.pem
**/*.key
**/*.p12
**/*.pfx

**/node_modules
**/node_modules/**
**/.venv
**/.venv/**
**/venv
**/venv/**
**/__pycache__
**/__pycache__/**
**/.pytest_cache
**/.pytest_cache/**
**/.mypy_cache
**/.mypy_cache/**
**/.ruff_cache
**/.ruff_cache/**
**/.cache
**/.cache/**

**/data
**/data/**
**/uploads
**/uploads/**
**/volumes
**/volumes/**
**/backups
**/backups/**
**/backup
**/backup/**
**/corpus
**/corpus/**
**/artifacts
**/artifacts/**
**/dist
**/dist/**
**/build
**/build/**

# The signed retrieval scope is package data required by every v2 identity
# boundary. These rules intentionally follow the generic artifacts deny.
!packages/contracts/src/nexus_contracts/artifacts/
!packages/contracts/src/nexus_contracts/artifacts/pilot-retrieval-scope-v1.json
